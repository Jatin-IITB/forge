# --- Secrets / env ---
.env
.env.*
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Large artifacts: NEVER commit weights / big generated data ---
# (use a model registry or release assets instead)
models/
checkpoints/
*.safetensors
*.bin
*.gguf
*.pt
*.onnx
wandb/
runs/

# Generated / synthetic data (bulk). Keep the small curated gold set tracked.
data/generated/
data/synthetic/
data/cache/
data/train*.jsonl
data/targeted_train*.jsonl
data/predictions_*.jsonl
data/*.meta.json
data/error_analysis_*.json
data/seeds/
*.log.jsonl
!data/gold/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# Long-run job logs
logs/

# Private working docs (aspirational drafts — must not ship publicly)
RESUME_BRIEF.md
# data/ood_probe.jsonl and data/carriers_v3.jsonl are EVALUATION assets, not
# generated bulk: G6 is a contract gate and train_v3 cannot be rebuilt without
# the carriers. adr/0003 requires a stranger to rebuild end-to-end from a clone.
!data/ood_probe.jsonl
!data/carriers_v3.jsonl
data/ood_results_*.json
data/teacher_token_sample.jsonl

# WP-2 data engine: teacher-written carrier shapes and the k=3 label cache.
# Generated, so untracked like every other generated set here — `make carriers`
# rebuilds them. reports/data_card_v3.md records the count, registers, seed and
# token cost so the artifact stays described even though it is not committed.
!data/carriers_v3.jsonl

# --- Gated external corpora (ADR 0022) ---
# bigcode/bigcode-pii-dataset Term 2: "You agree that you will not share
# the PII dataset or any modified versions for whatever purpose." It also
# contains REAL PII scraped from public repositories. Numbers derived from
# it may be published; the data and anything derived from it may not.
data/external/
